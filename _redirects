# Netlify + Cloudflare Pages redirects. Publish directory must be the
# shortxx.live/ folder itself so /ntok.css, /js/..., /discover/... resolve.
# Guest-only site: feed (/), Discover, Trending. Removed routes
# (/creator/*, /creators, /liked, /saved) fall through to 404.html.
/discover  /discover/  200
/trending  /trending/  200
/creators  /  301
/creator/*  /  301
/liked  /  301
/liked/*  /  301
/saved  /  301
/saved/*  /  301
/saved.html  /  301
/@*  /  301
